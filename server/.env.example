# Copy this file to server/.env and fill in your own values. Never commit server/.env.

# Port the API listens on (default 5000).
PORT=5000

# Local MongoDB, or your MongoDB Atlas connection string (mongodb+srv://...).
MONGODB_URI=mongodb://127.0.0.1:27017/profit-pulse

# A long random value, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# Website address(es) allowed to call this API. Separate several with commas.
# Local: http://localhost:5173. For a same-domain Embarko deployment, this can be blank.
CLIENT_URL=http://localhost:5173

# Optional: adds Gemini-written, business-specific questions to the assessment.
# Leave both blank to use the built-in question bank instead.
GEMINI_API_KEY=
# Use GEMINI_MODEL. GEMMA_MODEL also works for backward-compatible local settings.
GEMINI_MODEL=gemma-4-26b-a4b-it
